# --- server ---
HOST=127.0.0.1
PORT=8000

# Comma-separated allowed origins. "*" (the default) allows any origin but
# disables credentialed requests, which is fine for the demo.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- voice agent (OpenAI Realtime) ---
# The backend only serves the tool schema and dispatches tool calls; the
# Realtime session itself is opened by the client with this key.
OPENAI_API_KEY=sk-your_key_here
OPENAI_REALTIME_MODEL=gpt-realtime

# --- future: real persistence instead of the in-memory demo stores ---
DATABASE_URL=sqlite:///./parivahan.db
SECRET_KEY=your_secret_key_here
