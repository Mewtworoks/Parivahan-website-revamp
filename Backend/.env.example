# --- server ---
HOST=127.0.0.1
PORT=8000

# Comma-separated allowed origins. "*" (the default) allows any origin but
# disables credentialed requests, which is fine for the demo.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Saarthi voice agent (NVIDIA, server-side only) ---
# Never put this key in the frontend or commit it. Copy this file to .env and
# add a newly rotated key locally.
NVIDIA_API_KEY=nvapi-your_rotated_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# --- future: real persistence instead of the in-memory demo stores ---
DATABASE_URL=sqlite:///./parivahan.db
SECRET_KEY=your_secret_key_here
