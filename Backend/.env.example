# --- server ---
HOST=127.0.0.1
PORT=8000

# Comma-separated allowed origins. "*" (the default) allows any origin but
# disables credentialed requests, which is fine for the demo — nothing here
# sends credentials. On a deployed build, name the frontend origin instead:
#   CORS_ORIGINS=https://your-site.netlify.app
# A dev server on a port that is not listed fails with a CORS error that looks
# exactly like the backend being down.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173

# --- Saarthi voice agent (NVIDIA, server-side only) ---
# Never put this key in the frontend or commit it. Copy this file to .env and
# add a newly rotated key locally.
NVIDIA_API_KEY=nvapi-your_rotated_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# --- storage ---
# Persistence is real: SQLite in WAL mode, at Backend/state.db by default.
#
# DATABASE_URL is left commented on purpose. Setting it wins outright over
# everything below, so an uncommented line here silently moves the database to
# ./parivahan.db relative to whatever directory you launched from — an empty
# demo that reads as data loss. Uncomment it only to point at a real MySQL or
# Postgres instance, which is the entire migration; no statement changes.
# DATABASE_URL=mysql+pymysql://user:pass@host/parivahan
#
# Where the SQLite file lives, when DATABASE_URL is unset. Leave it blank for
# the default. ":memory:" is reserved for the test suite and means a private
# temporary file, not SQLite's in-memory database.
# STATE_FILE=

# HMAC key for the anonymous `signals` reference — not an app secret, but
# without it that reference is guessable, which defeats the point of it.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
